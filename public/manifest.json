{
  "manifest_version": 3,
  "name": "SS Watcher",
  "version": "0.3.0",
  "description": "Local-only Shopify storefront catalog and frontend intelligence tool.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "optional_host_permissions": [],
  "background": {
    "service_worker": "assets/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/ss-watcher-16.png",
    "32": "icons/ss-watcher-32.png",
    "48": "icons/ss-watcher-48.png",
    "128": "icons/ss-watcher-128.png"
  },
  "action": {
    "default_title": "Open SS Watcher",
    "default_icon": {
      "16": "icons/ss-watcher-16.png",
      "32": "icons/ss-watcher-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  }
}
